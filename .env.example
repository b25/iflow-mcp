# Copy to .env and replace placeholders. Never commit .env.

IFLOW_BASE_URL=https://your-iflow-host.example.com
# Local Django over HTTP only: IFLOW_ALLOW_INSECURE_HTTP=1 (never in production)
# IFLOW_ALLOW_INSECURE_HTTP=0
# Optional: comma-separated hostnames allowed for outbound calls. When omitted, defaults to the hostname of IFLOW_BASE_URL.
# IFLOW_ALLOWED_HOSTS=your-iflow-host.example.com

# Integration bearer from Django: Api Point settings (api_key / JWT string)
IFLOW_API_BEARER=replace-with-your-bearer-token

# Full JSON map: logical tool key -> api-external path UUID (ignored when IFLOW_MCP_INTEGRATION_UUID is set).
# Start from examples/iflow-api-points.sample.json and replace each UUID with real Api Points from iflow admin.
IFLOW_API_POINTS={"list_clients":"00000000-0000-4000-8000-000000000000"}

# Optional: Django MCP broker — opaque Bearer from /integrations/mcp/settings/ (CompanyIntegrations.integration_uuid).
# When set, requests go to GET|POST {IFLOW_BASE_URL}/v1/<uuid>/<logical_endpoint>/ instead of api-external.
# IFLOW_MCP_INTEGRATION_UUID=

# 0 = allow POST tools (e.g. create_order). 1 = read-only. Default 0 if unset.
IFLOW_READ_ONLY=0

IFLOW_LOG_LEVEL=info
IFLOW_REQUEST_TIMEOUT_MS=20000
IFLOW_MAX_RESPONSE_BYTES=10485760
IFLOW_MAX_PAGES_PER_CALL=5

# Phase B/C (remote MCP + OAuth) — optional for desktop stdio
# IFLOW_OAUTH_ISSUER=
# IFLOW_OAUTH_JWKS_URL=
# IFLOW_MCP_AUDIENCE=

# Restrict HTTP transport to BFF callers (requires X-BFF-Secret header matching this value)
# IFLOW_BFF_ONLY=0
# When IFLOW_BFF_ONLY=1, IFLOW_BFF_SHARED_SECRET must be set (non-empty) or the server will not start.
# IFLOW_BFF_SHARED_SECRET=

# IFLOW_MCP_TRANSPORT=http
# IFLOW_READ_ONLY defaults to 0 (writes allowed); set IFLOW_READ_ONLY=1 for read-only HTTP.
# IFLOW_HTTP_BIND_HOST=127.0.0.1
# In Docker use 0.0.0.0 so the container accepts mapped ports.
# PORT=3000
