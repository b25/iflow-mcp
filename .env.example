# iFlow ERP Base URL
IFLOW_BASE_URL=https://erp.example.com

# Comma-separated list of allowed hosts for security
IFLOW_ALLOWED_HOSTS=erp.example.com

# Integration Bearer Token (Phase A/B)
IFLOW_API_BEARER=your_bearer_token_here

# JSON mapping of logic names to iFlow API path UUIDs
IFLOW_API_POINTS={"clients":"uuid-1","products":"uuid-2","stocks":"uuid-3","orders":"uuid-4"}

# Read-only mode (1 = enabled, 0 = disabled)
IFLOW_READ_ONLY=1

# Other optional settings
IFLOW_LOG_LEVEL=info
IFLOW_REQUEST_TIMEOUT_MS=20000
IFLOW_MAX_PAGES_PER_CALL=5
