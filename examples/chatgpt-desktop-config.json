{
  "mcpServers": {
    "iflow": {
      "command": "node",
      "args": ["/absolute/path/to/iflow-mcp/dist/index.js"],
      "env": {
        "IFLOW_BASE_URL": "https://erp.example.com",
        "IFLOW_ALLOWED_HOSTS": "erp.example.com",
        "IFLOW_API_BEARER": "your-integration-bearer-token",
        "IFLOW_API_POINTS": "{\"list_clients\":\"00000000-0000-4000-8000-000000000001\",\"list_products\":\"00000000-0000-4000-8000-000000000002\"}",
        "IFLOW_READ_ONLY": "1"
      }
    }
  }
}
