{
  "mcpServers": {
    "iflow-local": {
      "command": "node",
      "args": ["/absolute/path/to/iflow-mcp/dist/index.js"],
      "env": {
        "IFLOW_BASE_URL": "http://localhost:57882",
        "IFLOW_ALLOW_INSECURE_HTTP": "1",
        "IFLOW_ALLOWED_HOSTS": "localhost",
        "IFLOW_API_BEARER": "${env:IFLOW_API_BEARER}",
        "IFLOW_API_POINTS": "${env:IFLOW_API_POINTS}",
        "IFLOW_READ_ONLY": "1"
      }
    }
  }
}
