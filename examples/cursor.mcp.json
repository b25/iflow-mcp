{
  "mcpServers": {
    "iflow": {
      "command": "node",
      "args": ["/absolute/path/to/iflows-mcp/dist/index.js"],
      "env": {
        "IFLOW_BASE_URL": "https://your-iflow.example.com",
        "IFLOW_ALLOWED_HOSTS": "your-iflow.example.com",
        "IFLOW_API_BEARER": "${env:IFLOW_API_BEARER}",
        "IFLOW_API_POINTS": "${env:IFLOW_API_POINTS}",
        "IFLOW_READ_ONLY": "0"
      }
    }
  }
}
