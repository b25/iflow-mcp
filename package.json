{
  "name": "iflows-mcp",
  "version": "0.1.3",
  "description": "iflow MCP server for Claude, OpenAI, and Gemini",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b25/iflow-mcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "iflows-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "examples",
    "docs",
    "ops",
    "scripts/mcp-contract-check.mjs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts && tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev:inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "validate:examples": "node scripts/validate-examples.mjs",
    "check:mcp-contract": "node scripts/mcp-contract-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/instrumentation-express": "^0.37.0",
    "@opentelemetry/instrumentation-http": "^0.49.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "express": "^4.22.1",
    "jose": "^5.9.6",
    "pino": "^9.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
